import type { Metadata } from "next";
import Link from "next/link";
import { notFound } from "next/navigation";
import { Container } from "@/components/layout/container";
import { EmptyState } from "@/components/layout/empty-state";
import { getPublicBusiness } from "@/server/tenancy/public-business";
import { getTenantDb } from "@/server/tenancy/tenant-db";
import { getBookableDateRange } from "@/features/availability/local-time";
import { loadBookingOptions } from "@/features/public-booking/load-booking-options";
import { parseBookingParams, bookingHref } from "@/features/public-booking/booking-params";
import { formatMoney } from "@/features/services/money";
import { TimePicker } from "@/features/public-booking/components/time-picker";
import { bookingErrorMessage } from "@/features/public-booking/messages";
import { PublicBookingDetails } from "@/features/public-booking/components/public-booking-details";
export async function generateMetadata({ params }: { params: Promise<{ slug: string }> }): Promise<Metadata> { const { slug } = await params; const business = await getPublicBusiness(slug); if (!business) return { title: "Page not found", robots: { index: false, follow: false } }; return { title: `Book at ${business.name}`, description: `Book an appointment online with ${business.name}.`, openGraph: { title: `Book at ${business.name}`, description: `Book an appointment online with ${business.name}.` } }; }
export default async function PublicBookingPage({ params, searchParams }: { params: Promise<{ slug: string }>; searchParams: Promise<Record<string, string | string[] | undefined>> }) { const { slug } = await params; const query = await searchParams; const business = await getPublicBusiness(slug); if (!business) notFound(); const db = getTenantDb(business.id); const [options, range] = await Promise.all([loadBookingOptions(db), Promise.resolve(getBookableDateRange(new Date(), business.timezone))]); if (!options.services.length) return <EmptyState icon={() => <span>✦</span>} title="No services are open for booking yet" description="Please contact this business directly for help." />; const state = parseBookingParams({ service: query.service, staff: query.staff, date: query.date, time: query.time }, options, range); const selectedService = options.services.find((s) => s.id === state.serviceId); const selectedStaff = selectedService?.staff.find((s) => s.id === state.staffId); const title = { service: "What would you like to book?", staff: "Who would you like to see?", time: "Pick a day and time", details: "Your details" }[state.step]; return <Container className="max-w-5xl"><div className="grid gap-8 lg:grid-cols-[280px_minmax(0,1fr)]"><aside className="h-fit rounded-xl border border-border bg-card p-5"><h2 className="font-heading font-semibold">Your booking</h2><div className="mt-3 space-y-2 text-sm">{selectedService ? <p>{selectedService.name} <Link className="ml-2 underline" href={bookingHref(slug,{})}>Change</Link></p> : <p className="text-muted-foreground">Choose a service</p>}{state.staffId ? <p>{selectedStaff?.name ?? (state.staffId === "any" ? "First available" : "Staff selected")}</p> : null}{state.date ? <p>{state.date}</p> : null}{state.time ? <p>{new Date(state.time).toLocaleString("en-US", { timeZone: business.timezone, dateStyle: "medium", timeStyle: "short" })}</p> : null}</div></aside><section><h1 className="mb-6 font-heading text-2xl font-semibold">{title}</h1>{state.step === "service" ? <div className="divide-y rounded-xl border border-border">{options.services.map((service) => <Link key={service.id} className="flex items-center justify-between gap-4 p-4 hover:bg-muted" href={bookingHref(slug,{service:service.id, ...(service.staff.length===1 ? {staff:service.staff[0].id} : {})})}><span className="font-medium">{service.name}<span className="mt-1 block text-sm text-muted-foreground">{service.durationMinutes} min</span></span><span>{formatMoney(service.priceCents,business.currency)}</span></Link>)}</div> : null}{state.step === "staff" && selectedService ? <div className="grid gap-3">{[{id:"any",name:"Anyone available",bio:"We'll pick someone for you"},...selectedService.staff].map((person) => <Link key={person.id} className="rounded-xl border border-border p-4 hover:bg-muted" href={bookingHref(slug,{service:selectedService.id,staff:person.id})}><span className="font-medium">{person.name}</span>{person.bio ? <span className="mt-1 block line-clamp-2 text-sm text-muted-foreground">{person.bio}</span> : null}</Link>)}</div> : null}{state.step === "time" && selectedService && state.staffId ? <TimePicker slug={slug} serviceId={selectedService.id} staffId={state.staffId === "any" ? null : state.staffId} timezone={business.timezone} firstDate={range.firstDate} lastDate={range.lastDate} initialDate={state.date ?? range.firstDate} /> : null}{state.step === "details" && selectedService && state.staffId && state.time ? <PublicBookingDetails slug={slug} serviceId={selectedService.id} staffId={state.staffId === "any" ? null : state.staffId} startsAt={state.time} serviceName={selectedService.name} staffName={selectedStaff?.name ?? "First available"} price={formatMoney(selectedService.priceCents,business.currency)} timezone={business.timezone} /> : null}</section></div></Container>; }
