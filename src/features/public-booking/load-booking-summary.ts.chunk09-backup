import type { TenantDb } from "@/server/tenancy/types";
import { bookingRefSchema } from "@/features/bookings/schemas";
export async function loadBookingSummary(db: TenantDb, cancelToken: string) { const parsed = bookingRefSchema.safeParse({ cancelToken }); if (!parsed.success) return null; const booking = await db.booking.findFirst({ where: { cancelToken: parsed.data.cancelToken }, select: { id: true, status: true, startsAt: true, endsAt: true, serviceId: true, staffId: true, service: { select: { name: true, durationMin: true, priceCents: true } }, staff: { select: { name: true } }, customer: { select: { name: true } } } }); if (!booking) return null; return { id: booking.id, status: booking.status, startsAt: booking.startsAt, endsAt: booking.endsAt, serviceId: booking.serviceId, staffId: booking.staffId, serviceName: booking.service.name, durationMinutes: booking.service.durationMin, priceCents: booking.service.priceCents, staffName: booking.staff.name, customerName: booking.customer.name }; }
