# PostgreSQL pooled connection URL used by the application
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# PostgreSQL direct connection URL used for administrative/database operations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth.js secret; use a randomly generated value with at least 32 characters
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Google OAuth credentials
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Public base URL of the Bookfleet application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Stripe test-mode secret key (must start with sk_test_)
STRIPE_SECRET_KEY="sk_test_replace_me"
# Stripe webhook signing secret (must start with whsec_)
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
# Stripe recurring monthly price ID for Pro (must start with price_)
STRIPE_PRICE_PRO="price_replace_me"
# Stripe recurring monthly price ID for Business (must start with price_)
STRIPE_PRICE_BUSINESS="price_replace_me"
